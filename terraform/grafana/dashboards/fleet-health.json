{
  "uid": "fleet-health",
  "title": "Fleet health",
  "description": "Replicas, GPU state, serving, throughput and goodput of the vllm-gpu serving fleet (ADR-0026, \"Panels\"). Each GPU, serving, throughput and goodput panel shows the fleet aggregate beside a per-pod breakdown.",
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Replicas",
      "description": "vllm-gpu replicas available against desired, from kube-state-metrics.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"slipstream\", deployment=\"vllm-gpu\"})",
          "legendFormat": "available"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kube_deployment_spec_replicas{namespace=\"slipstream\", deployment=\"vllm-gpu\"})",
          "legendFormat": "desired"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU busy time",
      "description": "DCGM_FI_DEV_GPU_UTIL: the share of time a kernel was running on the GPU, averaged over the GPUs slipstream pods hold, fleet-wide and per pod. It is near 100% whenever any request is in flight, so it shows idle against serving, not how much load.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL{namespace=\"slipstream\", pod!=\"\"})",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by (pod) (DCGM_FI_DEV_GPU_UTIL{namespace=\"slipstream\", pod!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU memory-bandwidth active",
      "description": "DCGM_FI_PROF_DRAM_ACTIVE: the share of cycles the device memory interface was busy, averaged over the GPUs slipstream pods hold, fleet-wide and per pod. Each decode step reads the model weights and every running sequence's KV cache. Batching shares the weight reads, so with short contexts this falls as concurrency rises, and it climbs as long contexts fill the KV cache.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg(DCGM_FI_PROF_DRAM_ACTIVE{namespace=\"slipstream\", pod!=\"\"})",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by (pod) (DCGM_FI_PROF_DRAM_ACTIVE{namespace=\"slipstream\", pod!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "KV-cache usage",
      "description": "vllm:kv_cache_usage_perc: the share of each replica's KV-cache blocks in use, averaged over the replicas fleet-wide, and per pod. Near 1, new requests wait for blocks and running ones can be preempted.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg(vllm:kv_cache_usage_perc{namespace=\"slipstream\"})",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by (pod) (vllm:kv_cache_usage_perc{namespace=\"slipstream\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests waiting",
      "description": "vllm:num_requests_waiting: requests queued for the scheduler, not yet running, fleet-wide and per pod.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(vllm:num_requests_waiting{namespace=\"slipstream\"})",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (pod) (vllm:num_requests_waiting{namespace=\"slipstream\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "TTFT p95",
      "description": "p95 time to first token from vLLM's histogram, fleet-wide and per pod. Goodput's TTFT gate is 1 s. vLLM's histograms carry no exemplars.",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{namespace=\"slipstream\"}[$__rate_interval])))",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, pod) (rate(vllm:time_to_first_token_seconds_bucket{namespace=\"slipstream\"}[$__rate_interval])))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "E2E latency p95",
      "description": "p95 end-to-end latency of vLLM's llm_request spans, from the Collector's span metrics, fleet-wide and per pod. Exemplars on the fleet line open the trace, which carries the request_id. Span metrics flush once a minute.",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "interval": "1m",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_seconds_bucket{service_name=\"vllm\", span_name=\"llm_request\"}[$__rate_interval])))",
          "legendFormat": "fleet",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, k8s_pod_name) (rate(traces_span_metrics_duration_seconds_bucket{service_name=\"vllm\", span_name=\"llm_request\"}[$__rate_interval])))",
          "legendFormat": "{{k8s_pod_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Output tokens/s",
      "description": "vllm:generation_tokens_total: tokens generated per second, fleet-wide and per pod.",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(vllm:generation_tokens_total{namespace=\"slipstream\"}[$__rate_interval]))",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (pod) (rate(vllm:generation_tokens_total{namespace=\"slipstream\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Prompt tokens/s",
      "description": "vllm:prompt_tokens_total: prompt tokens processed per second, fleet-wide and per pod.",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(vllm:prompt_tokens_total{namespace=\"slipstream\"}[$__rate_interval]))",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (pod) (rate(vllm:prompt_tokens_total{namespace=\"slipstream\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests/s",
      "description": "vllm:request_success_total: requests finished per second, for any finish reason, fleet-wide and per pod.",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(vllm:request_success_total{namespace=\"slipstream\"}[$__rate_interval]))",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (pod) (rate(vllm:request_success_total{namespace=\"slipstream\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Live goodput",
      "description": "The share of vLLM's llm_request spans whose request met the SLO (TTFT <= 1 s and TPOT <= 50 ms, the bench configs' goodput gates), from the Collector's span metrics split by slo_met, fleet-wide and per pod. It reads as the bench report's goodput_fraction. Span metrics flush once a minute; with no requests in the window it shows no data, and with none meeting the SLO, 0.",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 8 },
      "interval": "1m",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(sum(rate(traces_span_metrics_calls_total{service_name=\"vllm\", span_name=\"llm_request\", slo_met=\"true\"}[$__rate_interval])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{service_name=\"vllm\", span_name=\"llm_request\"}[$__rate_interval]))",
          "legendFormat": "fleet"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(sum by (k8s_pod_name) (rate(traces_span_metrics_calls_total{service_name=\"vllm\", span_name=\"llm_request\", slo_met=\"true\"}[$__rate_interval])) or 0 * sum by (k8s_pod_name) (rate(traces_span_metrics_calls_total{service_name=\"vllm\", span_name=\"llm_request\"}[$__rate_interval]))) / sum by (k8s_pod_name) (rate(traces_span_metrics_calls_total{service_name=\"vllm\", span_name=\"llm_request\"}[$__rate_interval]))",
          "legendFormat": "{{k8s_pod_name}}"
        }
      ]
    }
  ]
}
