#!/usr/bin/env bash
# Boot script for the ephemeral bench host. Installs Docker, logs in to ECR, and
# pulls the baked bench-client image so it is resident before any sweep runs. The
# sweep itself is driven later over an SSM session; this script only readies the
# host. Rendered by Terraform (host.tf) with the region, ECR registry, image
# reference and results bucket; do not run it directly.
#
# cloud-init runs this after the instance is already "running", so a failure here
# does not fail the instance: the host would come up healthy-looking but unable
# to run the sweep. To make that loud, the boot outcome is written to the results
# bucket (boot-status/<instance-id>) — ok on success, failed with the log tail on
# error — so the operator can check readiness before opening a session.
set -euo pipefail

token="$(curl -sX PUT http://169.254.169.254/latest/api/token \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
instance_id="$(curl -s -H "X-aws-ec2-metadata-token: $token" \
  http://169.254.169.254/latest/meta-data/instance-id)"
status_key="boot-status/$instance_id"

report() {
  local state=$1
  aws s3 cp - "s3://${results_bucket}/$status_key" \
    --region "${region}" --content-type text/plain <<<"$state" || true
}

on_error() {
  local line=$1
  echo "bench-host boot failed at line $line (image=${image_ref})" >&2
  report "failed at line $line; see /var/log/cloud-init-output.log on $instance_id"
}
trap 'on_error $LINENO' ERR

echo "bench-host boot: installing docker" >&2
dnf install -y docker
systemctl enable --now docker

echo "bench-host boot: logging in to ECR" >&2
aws ecr get-login-password --region "${region}" |
  docker login --username AWS --password-stdin "${ecr_registry}"

echo "bench-host boot: pulling ${image_ref}" >&2
docker pull "${image_ref}"
docker image inspect "${image_ref}" >/dev/null ||
  { echo "image ${image_ref} not resident after pull; did 'just bench-image' push this tag?" >&2; exit 1; }

echo "bench-host boot: ok" >&2
report ok
