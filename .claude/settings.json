{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(kubectl -n prefect get *)",
      "Bash(kubectl -n prefect set image deploy/prefect-worker *)",
      "Bash(kubectl -n prefect rollout status deploy/prefect-worker*)",
      "Bash(kubectl -n prefect exec *deploy/prefect-worker *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-review-before-a-pull-request.sh"
          }
        ]
      }
    ]
  }
}
