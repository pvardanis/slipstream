# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
# Bootstrap uses committed local state (it creates the remote state bucket).
# The .backup is a transient prior-state snapshot; git history is the rollback.
!terraform/bootstrap/terraform.tfstate
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv
.uv/

# Secrets / kube
*.pem
kubeconfig
*.kubeconfig

# macOS
.DS_Store

# Editors
.idea/
.vscode/

# Wayfinder scratch (planning lives in GitHub issues)
.scratch/

# Claude Code local state (agent worktrees, local settings). The shared PR-review
# guard is tracked; everything else under .claude/ stays local.
.claude/*
!.claude/settings.json
!.claude/hooks/

# MLSD review scorecard (local artifact, not tracked)
mlsd-scorecard-slipstream.md
