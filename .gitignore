# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv
.uv/

# Secrets / kube
*.pem
kubeconfig
*.kubeconfig

# Benchmark result JSON (raw client output, regenerated per run)
bench/results/

# analyze-bench recommendation reports are tracked (trimmed tables plus the sweep's two
# plots, copied beside the report). Keep any other binary out.
reports/**/*.png
!reports/**/ceiling-by-max-num-seqs.png
!reports/**/goodput-by-max-concurrency.png
reports/**/*.jpg
reports/**/*.jpeg

# macOS
.DS_Store

# Editors
.idea/
.vscode/

# Wayfinder scratch (planning lives in GitHub issues)
.scratch/

# Claude Code local state (agent worktrees, local settings). The shared PR-review
# guard and the team skills are tracked; everything else under .claude/ stays local.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/

# MLSD review scorecard (local artifact, not tracked)
mlsd-scorecard-slipstream.md
